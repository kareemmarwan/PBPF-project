# .env.example — أسماء إعدادات البيئة لموقع "بيت تراث العرب"
# ---------------------------------------------------------------
# القاعدة: هذا الملف يحتوي أسماء المتغيرات فقط دون أي بيانات حقيقية أو سرية.
# أنشئ ملف `.env.local` على مستوى الجذر وانسخ فيه الأسماء مع القيم الحقيقية.
# ملاحظة: الكود يقرأ هذه المتغيرات عبر `src/config/site.ts` — والقيم الافتراضية ديمو داخل الكود.
# ضع القيم الحقيقية في ملف `.env.local` (غيُرفع إلى Git) عند توفرها.

# --- معرفات الموقع (SEO / بدون حساسية) ---
# عنوان الموقع الكامل المستخدم في الروابط و OpenGraph و sitemap
VITE_SITE_URL=https://example.com

# --- بيانات التبرع (أرقام عامة - ليست سرية لكنها إعدادات) ---
# رقم الآيبان المعروض في صفحة التبرع وقسم التبرع بالرئيسية
VITE_DONATION_IBAN=
# رابط زر "تبرع عبر كليك" (الدفع السريع) — يصبح الزر فعّالاً عند تعيينه
VITE_DONATION_CLICK_LINK=
# رابط التبرع عبر باي بال (مثال: paypal.me/xxx) — الزر فعّال عند تعيينه
VITE_DONATION_PAYPAL_LINK=
# عنوان محفظة USDT الظاهر مع زر النسخ — يُستبدل العنوان الديمو عند تعيينه
VITE_DONATION_USDT_ADDRESS=
# الشبكة الظاهرة بجانب عنوان USDT (مثل TRC20 / ERC20 / BEP20)
VITE_DONATION_USDT_NETWORK=TRC20

# --- بيانات التواصل (أرقام عامة) ---
# الهاتف المعروض في الفوتر وصفحة التواصل بصيغة دولية: +9665XXXXXXXX
VITE_CONTACT_PHONE=
# البريد الرسمي المعروض
VITE_CONTACT_EMAIL=

# --- نقطة إرسال نموذج التواصل ---
# نقطة نهاية إرسال رسائل نموذج التواصل (تُضاف لاحقاً في المرحلة 4 / 4.3)
# مثال: رابط خدمة Formspree أو endpoint خاص. لا تضع مفاتيح سرّية هنا.
VITE_CONTACT_ENDPOINT=

# --- إعدادات الخدمة السحابية (تُفعَّل عند قرار Backend مستقبلاً) ---
# عنوان API المستقبلي — يُوضع فقط عند اختيار خدمة (مثل Supabase)
# VITE_API_URL=

# --- Supabase (لوحة التحكم /admin + مصادر المحتوى) ---
# من Supabase → Project Settings → API. تفاصيل التهيئة كاملة في `SUPABASE-SETUP.md`
# غيابهما يعني عمل الموقع بالبيانات الديمو مع شاشة إعداد تظهر في /admin
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
